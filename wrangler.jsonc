{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bucket0-web",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "placement": { "mode": "smart" },
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "vars": {
    "NODE_ENV": "production"
  },
  // Rename the bucket and queues to resources in your account, and add "routes" for your own domain.
  "durable_objects": { "bindings": [
    { "name": "RATE_LIMITS", "class_name": "RateLimitCounter" },
    { "name": "MEDIA_CONTAINER", "class_name": "MediaContainer" }
  ] },
  "migrations": [{ "tag": "cf-infra-v1", "new_sqlite_classes": ["RateLimitCounter", "MediaContainer"] }],
  "containers": [{ "class_name": "MediaContainer", "image": "./media/Dockerfile", "max_instances": 1, "instance_type": "basic" }],
  "r2_buckets": [{ "binding": "THUMBNAILS", "bucket_name": "bucket0-thumbnails" }],
  "queues": {
    "producers": [{ "binding": "BACKGROUND_QUEUE", "queue": "bucket0-background" }],
    "consumers": [{ "queue": "bucket0-background", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 3, "dead_letter_queue": "bucket0-background-dlq", "max_concurrency": 1 }]
  }
  // Secrets (wrangler secret put / .dev.vars): DATABASE_URL, CLERK_SECRET_KEY, CLERK_WEBHOOK_SECRET,
  // NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY, ENCRYPTION_KEY, CREDENTIAL_ENCRYPTION_KEY, R2_ACCOUNT_ID,
  // R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET_NAME, R2_CUSTOM_DOMAIN, POLAR_*, RESEND_*,
  // EMBEDDING_*, OAUTH_BRIDGE_SECRET, MCP_WORKER_ORIGIN, NEXT_PUBLIC_APP_URL, NEXT_PUBLIC_POLAR_SERVER,
  // HEALTH_CHECK_TOKEN (optional protected readiness checks), MEDIA_SERVICE_URL and MEDIA_SERVICE_TOKEN
  // (optional: use an external media service instead of MEDIA_CONTAINER)
}
