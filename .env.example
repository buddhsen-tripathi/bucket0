NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=clerk_publishable_key
CLERK_SECRET_KEY=clerk_secret_key
CLERK_WEBHOOK_SECRET=clerk_webhook_secret

R2_ACCOUNT_ID=r2_account_id
R2_ACCESS_KEY_ID=r2_access_key_id
R2_SECRET_ACCESS_KEY=r2_secret_access_key
R2_BUCKET_NAME=r2_bucket_name
R2_CUSTOM_DOMAIN=r2_custom_domain

DATABASE_URL=postgresql://user:password@host:port/database

# Polar Payment Gateway
POLAR_ACCESS_TOKEN=polar_access_token
POLAR_WEBHOOK_SECRET=polar_webhook_secret
POLAR_PRODUCT_ID_STARTER_MONTHLY=polar_product_id_starter_monthly
POLAR_PRODUCT_ID_STARTER_YEARLY=polar_product_id_starter_yearly
POLAR_PRODUCT_ID_PRO_MONTHLY=polar_product_id_pro_monthly
POLAR_PRODUCT_ID_PRO_YEARLY=polar_product_id_pro_yearly
POLAR_PRODUCT_ID_SCALE_MONTHLY=polar_product_id_scale_monthly
POLAR_PRODUCT_ID_SCALE_YEARLY=polar_product_id_scale_yearly
NEXT_PUBLIC_POLAR_SERVER=sandbox

# File Encryption - AES-128-GCM
# Generate with: openssl rand -hex 16
ENCRYPTION_KEY=your_32_character_hex_key_for_files

# S3 Credential Encryption - AES-256-GCM (more secure for credentials)
# Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=your_64_character_hex_key_for_credentials

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com

# App URL (for email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AgentBucket Memory - embeddings (OpenAI-compatible /embeddings endpoint, via OpenRouter)
# Provider must carry a no-retention / no-training guarantee.
# EMBEDDING_DIMENSIONS must match the memory_chunks.embedding vector column (1536).
EMBEDDING_API_URL=https://openrouter.ai/api/v1/embeddings
EMBEDDING_API_KEY=sk-or-v1-your_openrouter_key
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Remote MCP connector OAuth bridge (mcp.bucket0.com Worker <-> bucket0.com consent)
# Shared secret: the /oauth/consent page seals the minted key into an AES-GCM code
# with this; the Worker decrypts it with the SAME value. Generate: openssl rand -hex 32
# Set the identical value as the Worker secret: wrangler secret put OAUTH_BRIDGE_SECRET
OAUTH_BRIDGE_SECRET=your_64_character_hex_shared_secret
# Origin of the remote MCP Worker (only the consent callback may target it).
MCP_WORKER_ORIGIN=https://mcp.bucket0.com
# Optional Google Analytics (leave unset to disable)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
