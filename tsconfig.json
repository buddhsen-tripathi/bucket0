{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "types": [
      "vite/client",
      "node"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "rootDirs": [
      ".",
      "./.react-router/types"
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "worker-configuration.d.ts",
    "web/**/*",
    "server/**/*",
    "workers/**/*",
    "lib/**/*",
    "components/**/*",
    "hooks/**/*",
    "db/**/*",
    "types/**/*",
    "__tests__/**/*",
    ".react-router/types/**/*",
    "vite.config.ts",
    "react-router.config.ts",
    "vitest.config.ts",
    "drizzle.config.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    "media",
    "app"
  ]
}
