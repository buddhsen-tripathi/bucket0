{
  "openapi": "3.1.0",
  "info": {
    "title": "Bucket0 AgentBucket API",
    "version": "1.4.0",
    "description": "REST API for AI agents and CLI tools to upload, download, list, share, and search files in AgentBucket. Authenticate with Bearer API keys (prefix b0ak_). Create keys in the Bucket0 dashboard after signing in.",
    "contact": {
      "name": "Bucket0",
      "url": "https://bucket0.com/contact",
      "email": "team@bucket0.com"
    }
  },
  "servers": [
    {
      "url": "https://bucket0.com/api/agent-bucket",
      "description": "Production AgentBucket API"
    }
  ],
  "security": [{ "AgentApiKey": [] }],
  "components": {
    "securitySchemes": {
      "AgentApiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "b0ak_",
        "description": "Agent API key created in the Bucket0 dashboard. Format: Authorization: Bearer b0ak_..."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string" },
          "code": { "type": "string" },
          "details": { "type": "object" }
        }
      },
      "AgentFile": {
        "type": "object",
        "properties": {
          "key": { "type": "string" },
          "fileName": { "type": "string" },
          "size": { "type": "integer" },
          "mimeType": { "type": "string" },
          "isStarred": { "type": "boolean" },
          "uploadedVia": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "paths": {
    "/files/upload": {
      "post": {
        "summary": "Upload a file",
        "operationId": "uploadFile",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "file": { "type": "string", "format": "binary" },
                  "filename": {
                    "type": "string",
                    "description": "Optional relative key path, e.g. research/results.json"
                  },
                  "index": {
                    "type": "string",
                    "default": "true",
                    "description": "Memory indexing for this file on plans with memory search (Starter and up). Send false, 0, no or off to skip. Only text files up to 1 MB are indexed."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Upload succeeded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "key": { "type": "string" },
                    "fileName": { "type": "string" },
                    "size": { "type": "integer" },
                    "destination": { "type": "string", "enum": ["agent", "drive"] }
                  }
                }
              }
            }
          },
          "400": { "description": "Missing file, invalid file path, or invalid destination folder on this API key", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "402": { "description": "Quota, plan limit, or file size exceeded", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "404": { "description": "User not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "409": { "description": "A file already exists at this path", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "429": { "description": "Rate limit exceeded (100 uploads per minute)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }, "headers": { "X-RateLimit-Limit": { "schema": { "type": "integer" } }, "X-RateLimit-Remaining": { "schema": { "type": "integer" } }, "X-RateLimit-Reset": { "schema": { "type": "integer" }, "description": "Unix timestamp when the limit resets" } } },
          "500": { "description": "Upload failed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/files": {
      "get": {
        "summary": "List agent files",
        "operationId": "listFiles",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "pageSize", "in": "query", "schema": { "type": "integer", "default": 50, "maximum": 100 } }
        ],
        "responses": {
          "200": {
            "description": "Paginated file list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "files": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/AgentFile" }
                    },
                    "pagination": {
                      "type": "object",
                      "properties": {
                        "total": { "type": "integer" },
                        "page": { "type": "integer" },
                        "pageSize": { "type": "integer" },
                        "hasMore": { "type": "boolean" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete an agent file",
        "operationId": "deleteFile",
        "parameters": [
          {
            "name": "key",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "Relative file key"
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "success": { "type": "boolean" } }
                }
              }
            }
          },
          "404": { "description": "Not found" }
        }
      }
    },
    "/files/download": {
      "get": {
        "summary": "Download a file",
        "operationId": "downloadFile",
        "parameters": [
          {
            "name": "key",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Binary file stream",
            "content": {
              "application/octet-stream": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          },
          "404": { "description": "Not found" }
        }
      }
    },
    "/files/folder": {
      "post": {
        "summary": "Create a folder",
        "operationId": "createFolder",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["path"],
                "properties": {
                  "path": {
                    "type": "string",
                    "description": "Folder path, e.g. reports/daily"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Folder created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "path": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/files/share": {
      "post": {
        "summary": "Create a public share/stream link",
        "description": "Creates a public link (anyone with the link) for a file in Agent Storage. Files written by a key with the My Drive destination are not eligible and return 404. If an active link already exists for the key, it is returned. streamUrl supports HTTP Range requests.",
        "operationId": "shareFile",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["key"],
                "properties": {
                  "key": { "type": "string", "description": "Relative file key, e.g. videos/demo.mp4. Must not contain '..' or end with '/'." },
                  "allowDownload": { "type": "boolean", "default": true, "description": "Let viewers download the file. Set false for view-only." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Share link created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "linkId": { "type": "string" },
                    "shareUrl": { "type": "string", "format": "uri", "description": "Viewer page, https://bucket0.com/s/{linkId}" },
                    "streamUrl": { "type": "string", "format": "uri", "description": "Direct stream, https://bucket0.com/api/cloud/share/stream?id={linkId}" }
                  }
                }
              }
            }
          },
          "400": { "description": "Valid file key required", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "404": { "description": "Agent file not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "429": { "description": "Rate limit exceeded (100 share links per hour)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }, "headers": { "X-RateLimit-Limit": { "schema": { "type": "integer" } }, "X-RateLimit-Remaining": { "schema": { "type": "integer" } }, "X-RateLimit-Reset": { "schema": { "type": "integer" }, "description": "Unix timestamp when the limit resets" } } },
          "500": { "description": "Failed to create share link", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/memory/search": {
      "post": {
        "summary": "Semantic memory search (Starter and up)",
        "description": "Searches indexed text from your AgentBucket files by meaning. Available on Starter, Pro and Scale. Text files up to 1 MB are indexed after upload, in 1,000-character chunks.",
        "operationId": "searchMemory",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["query"],
                "properties": {
                  "query": { "type": "string", "description": "Natural-language description of what to find" },
                  "topK": { "type": "integer", "default": 8, "minimum": 1, "maximum": 50, "description": "Number of results. Values outside 1-50 are clamped." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ranked memory snippets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "fileName": { "type": "string" },
                          "key": { "type": "string", "description": "Relative file key" },
                          "chunkIndex": { "type": "integer" },
                          "snippet": { "type": "string" },
                          "score": { "type": "number", "description": "Cosine similarity; higher is closer" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "query is required", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "402": { "description": "Memory search is not included in your plan", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "500": { "description": "Failed to search memory", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "503": { "description": "Memory search is not available", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    }
  }
}
